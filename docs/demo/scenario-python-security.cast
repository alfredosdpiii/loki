[0.536746, "o", "\u001b[2m    import requests, yaml\u001b[0m\r\n\u001b[2m    \u001b[0m\r\n\u001b[2m    def fetch_user(cursor, request):\u001b[0m\r\n\u001b[2m        user_id = request.args.get(\"id\")\u001b[0m\r\n\u001b[2m        cursor.execute(f\"SELECT * FROM users WHERE id = {user_id}\")\u001b[0m\r\n\u001b[2m        requests.get(request.args[\"callback_url\"])\u001b[0m\r\n\u001b[2m        return yaml.load(request.data)\u001b[0m\r\n"]
[1.263566, "o", "\r\n\u001b[31m\u001b[1m✗ blocked before write\u001b[0m\r\n"]
[1.265216, "o", "  \u001b[31mapi/users.py:6: loki/ssrf: server-side request forgery (SSRF): outbound request URL comes \u001b[0m\r\n  \u001b[31mfrom request data; validate the host against an allowlist\u001b[0m\r\n  \u001b[31mapi/users.py:5: loki/sql-injection: SQL injection: query text built by concatenation or \u001b[0m\r\n  \u001b[31minterpolation; use parameterized placeholders\u001b[0m\r\n  \u001b[31mapi/users.py:7: loki/unsafe-deserialization: unsafe deserialization: yaml.load without \u001b[0m\r\n  \u001b[31mSafeLoader can build arbitrary Python objects; use yaml.safe_load\u001b[0m\r\n"]
