[1.923656, "o", "\u001b[2m    // wait for background work to settle\u001b[0m\r\n\u001b[2m    import { test, expect } from \"vitest\";\u001b[0m\r\n\u001b[2m    import { double } from \"./calc.ts\";\u001b[0m\r\n\u001b[2m    \u001b[0m\r\n\u001b[2m    export function sample(): number {\u001b[0m\r\n\u001b[2m      return double(21);\u001b[0m\r\n\u001b[2m    }\u001b[0m\r\n\u001b[2m    \u001b[0m\r\n\u001b[2m    test(\"doubles input\", { retry: 2 }, async () => {\u001b[0m\r\n\u001b[2m      await new Promise((resolve) => setTimeout(resolve, 200));\u001b[0m\r\n\u001b[2m      expect(sample()).toBe(42);\u001b[0m\r\n\u001b[2m    });\u001b[0m\r\n"]
[2.972888, "o", "\u001b[31m\u001b[1m✗ blocked by Oxlint + landmines\u001b[0m\r\n"]
[2.974292, "o", "  \u001b[31moxlint: src/calc.test.ts:5:17: Do not export from a test file. [Error/jest(no-export)]\u001b[0m\r\n  \u001b[31moxlint: src/calc.test.ts:10:34: Return statement should not be used in Promise executor. \u001b[0m\r\n  \u001b[31m[Error/eslint(no-promise-executor-return)]\u001b[0m\r\n  \u001b[31moxlint: src/calc.test.ts:5:25: Remove the explicit return type and let it be inferred; \u001b[0m\r\n  \u001b[31mpin a contract with a typed variable or `satisfies` at the return site instead. \u001b[0m\r\n  \u001b[31m[Error/landmines-types(no-explicit-return-types)]\u001b[0m\r\n  \u001b[31moxlint: src/calc.test.ts:9:25: Do not retry tests. A test that passes on rerun is a \u001b[0m\r\n  \u001b[31mflake: wait on the event it depends on and file the failure under the flaky-test tracker. \u001b[0m\r\n  \u001b[31m[Error/landmines-testing(no-flake-masking)]\u001b[0m\r\n  \u001b[31moxlint: src/calc.test.ts:1:1: Remove this comment; express meaning in code and rationale \u001b[0m\r\n"]
