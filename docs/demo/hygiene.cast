[9.725166, "o", "\u001b[2m    import pathlib\u001b[0m\r\n\u001b[2m    \u001b[0m\r\n\u001b[2m    LIMIT = 10\u001b[0m\r\n\u001b[2m    \u001b[0m\r\n\u001b[2m    \u001b[0m\r\n\u001b[2m    def load_items(path: str) -> list[str]:\u001b[0m\r\n\u001b[2m        return pathlib.Path(path).read_text(encoding=\"utf-8\").splitlines()\u001b[0m\r\n\u001b[2m    \u001b[0m\r\n\u001b[2m    \u001b[0m\r\n\u001b[2m    def clear_cache(path: str) -> None:\u001b[0m\r\n\u001b[2m        pathlib.Path(path).unlink(missing_ok=True)\u001b[0m\r\n\u001b[2m    \u001b[0m\r\n"]
