[0.531977, "o", "\u001b[2m    use std::io::{BufWriter, Write};\u001b[0m\r\n\u001b[2m    \u001b[0m\r\n\u001b[2m    pub fn save(file: std::fs::File, items: &[u8], idx: usize) -> u8 {\u001b[0m\r\n\u001b[2m        let mut w = BufWriter::new(file);\u001b[0m\r\n\u001b[2m        let _ = w.write_all(items);\u001b[0m\r\n\u001b[2m        if items.is_empty() { todo!() }\u001b[0m\r\n\u001b[2m        unsafe { *items.get_unchecked(idx) }\u001b[0m\r\n\u001b[2m    }\u001b[0m\r\n"]
[1.21068, "o", "\r\n\u001b[31m\u001b[1m✗ blocked before write\u001b[0m\r\n"]
[1.214071, "o", "  \u001b[31msrc/store.rs:6: loki/placeholder: todo!() placeholder left in code panics at runtime\u001b[0m\r\n  \u001b[31msrc/store.rs:4: loki/unflushed-writer: BufWriter dropped without flush(): write errors on \u001b[0m\r\n  \u001b[31mdrop are silently discarded; call flush()? before returning\u001b[0m\r\n  \u001b[31msrc/store.rs:7: loki/unchecked-index: get_unchecked index is not bounds-checked in this \u001b[0m\r\n  \u001b[31mfunction; an out-of-bounds index is undefined behaviour\u001b[0m\r\n  \u001b[31msrc/store.rs:7: loki/unsafe-without-safety-comment: unsafe block or fn missing `// \u001b[0m\r\n  \u001b[31mSAFETY:` comment documenting the soundness invariant\u001b[0m\r\n  \u001b[31msrc/store.rs:5: loki/swallowed-result: `let _ = ...` silently discards a fallible I/O, \u001b[0m\r\n  \u001b[31mlock, or channel Result; propagate with `?`, log it, or document why ignoring it is safe\u001b[0m\r\n"]
