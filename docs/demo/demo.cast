[2.72252, "o", "\u001b[32m✓\u001b[0m hooks for Claude Code, Codex, Factory, Pi and OMP\r\n"]
[3.923555, "o", "\r\n\u001b[2m# The agent renders user comments with innerHTML\u001b[0m\r\n"]
[4.724887, "o", "\u001b[35m\u001b[1magent\u001b[0m \u001b[2m→ Write\u001b[0m src/comments.ts\r\n"]
[4.726027, "o", "\u001b[2m    export function show(node: HTMLElement, comment: string) {\u001b[0m\r\n\u001b[2m      node.innerHTML = comment;\u001b[0m\r\n\u001b[2m    }\u001b[0m\r\n"]
[5.564932, "o", "\u001b[31m\u001b[1m✗ blocked before the write\u001b[0m\r\n"]
[5.566957, "o", "  \u001b[31msrc/comments.ts:2: loki/unsanitized-html: cross-site scripting (XSS): non-literal HTML \u001b[0m\r\n  \u001b[31massigned to innerHTML; use textContent or a sanitizer\u001b[0m\r\n"]
[7.768044, "o", "\r\n\u001b[2m# It pastes a live API key into config\u001b[0m\r\n"]
[8.56933, "o", "\u001b[35m\u001b[1magent\u001b[0m \u001b[2m→ Write\u001b[0m src/config.ts\r\n"]
[8.570561, "o", "\u001b[2m    export const stripeKey = \"sk_live_51Hq8TzK2m9XbV4dLpQ7rW3nY6cF0aJ\";\u001b[0m\r\n"]
[9.374317, "o", "\u001b[31m\u001b[1m✗ blocked before the write\u001b[0m\r\n"]
[9.375511, "o", "  \u001b[31msrc/config.ts:1: loki/secret: hardcoded credential (Stripe live key); load it from the \u001b[0m\r\n  \u001b[31menvironment or a secret store and rotate the exposed value\u001b[0m\r\n"]
[11.576627, "o", "\r\n\u001b[2m# It changes a function and breaks a caller in another file\u001b[0m\r\n"]
[12.377858, "o", "\u001b[35m\u001b[1magent\u001b[0m \u001b[2m→ Write\u001b[0m src/prices.ts\r\n"]
[12.379039, "o", "\u001b[2m    export function totalCents(items: { cents: number }[]): string {\u001b[0m\r\n\u001b[2m      return (items.reduce((sum, item) => sum + item.cents, 0) / 100).toFixed(2);\u001b[0m\r\n\u001b[2m    }\u001b[0m\r\n"]
[14.773646, "o", "\u001b[31m\u001b[1m✗ blocked before the write\u001b[0m\r\n"]
