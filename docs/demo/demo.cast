[16.975833, "o", "\r\n\u001b[2m# It fixes the XSS the right way\u001b[0m\r\n"]
[17.777053, "o", "\u001b[35m\u001b[1magent\u001b[0m \u001b[2m→ Write\u001b[0m src/comments.ts\r\n"]
[17.778259, "o", "\u001b[2m    export function show(node: HTMLElement, comment: string) {\u001b[0m\r\n\u001b[2m      node.textContent = comment;\u001b[0m\r\n\u001b[2m    }\u001b[0m\r\n"]
[19.809031, "o", "\u001b[32m\u001b[1m✓ allowed\u001b[0m\r\n"]
[21.412123, "o", "\r\n\u001b[2m# It adds a sprawling function: allowed, but flagged as a new hotspot\u001b[0m\r\n"]
[22.213505, "o", "\u001b[35m\u001b[1magent\u001b[0m \u001b[2m→ Write\u001b[0m src/discounts.ts\r\n"]
[22.214593, "o", "\u001b[2m    export function discount(tier: string, cents: number, coupon?: string): number {\u001b[0m\r\n\u001b[2m      if (tier === \"t0\" && coupon) return cents * 90 / 100;\u001b[0m\r\n\u001b[2m      if (tier === \"t1\") return cents * 89 / 100;\u001b[0m\r\n\u001b[2m      if (tier === \"t2\") return cents * 88 / 100;\u001b[0m\r\n\u001b[2m      if (tier === \"t3\" && coupon) return cents * 87 / 100;\u001b[0m\r\n\u001b[2m      if (tier === \"t4\") return cents * 86 / 100;\u001b[0m\r\n"]
[24.28469, "o", "\u001b[32m\u001b[1m✓ allowed\u001b[0m\r\n"]
[24.286619, "o", "  \u001b[33mloki/slop-complexity: discount cyclomatic complexity 17 (> 10); split it into smaller \u001b[0m\r\n  \u001b[33mfunctions\u001b[0m\r\n"]
