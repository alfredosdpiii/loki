[3.002591, "o", "\u001b[32m✓\u001b[0m hooks for Claude Code, Codex, Factory, Pi and OMP\r\n"]
[4.203661, "o", "\r\n\u001b[2m# The agent renders user comments with innerHTML\u001b[0m\r\n"]
[5.005143, "o", "\u001b[35m\u001b[1magent\u001b[0m \u001b[2m→ Write\u001b[0m src/comments.ts\r\n"]
[5.006536, "o", "\u001b[2m    export function show(node: HTMLElement, comment: string) {\u001b[0m\r\n\u001b[2m      node.innerHTML = comment;\u001b[0m\r\n\u001b[2m    }\u001b[0m\r\n"]
[5.842581, "o", "\u001b[31m\u001b[1m✗ blocked before the write\u001b[0m\r\n"]
[5.843763, "o", "  \u001b[31msrc/comments.ts:2: loki/unsanitized-html: cross-site scripting (XSS): non-literal HTML \u001b[0m\r\n  \u001b[31massigned to innerHTML; use textContent or a sanitizer\u001b[0m\r\n"]
[8.044844, "o", "\r\n\u001b[2m# It pastes a live API key into config\u001b[0m\r\n"]
[8.846016, "o", "\u001b[35m\u001b[1magent\u001b[0m \u001b[2m→ Write\u001b[0m src/config.ts\r\n"]
[8.847059, "o", "\u001b[2m    export const stripeKey = \"sk_live_51Hq8TzK2m9XbV4dLpQ7rW3nY6cF0aJ\";\u001b[0m\r\n"]
[9.669318, "o", "\u001b[31m\u001b[1m✗ blocked before the write\u001b[0m\r\n"]
[9.670503, "o", "  \u001b[31msrc/config.ts:1: loki/secret: hardcoded credential (Stripe live key); load it from the \u001b[0m\r\n  \u001b[31menvironment or a secret store and rotate the exposed value\u001b[0m\r\n"]
[11.871721, "o", "\r\n\u001b[2m# It changes a function and breaks a caller in another file\u001b[0m\r\n"]
[12.67323, "o", "\u001b[35m\u001b[1magent\u001b[0m \u001b[2m→ Write\u001b[0m src/prices.ts\r\n"]
[12.674362, "o", "\u001b[2m    export function totalCents(items: { cents: number }[]): string {\u001b[0m\r\n\u001b[2m      return (items.reduce((sum, item) => sum + item.cents, 0) / 100).toFixed(2);\u001b[0m\r\n\u001b[2m    }\u001b[0m\r\n"]
[15.085284, "o", "\u001b[31m\u001b[1m✗ blocked before the write\u001b[0m\r\n"]
[15.086834, "o", "  \u001b[31msrc/checkout.ts:2: TS2322: Type 'string' is not assignable to type 'number'.\u001b[0m\r\n"]
[17.288041, "o", "\r\n\u001b[2m# It fixes the XSS the right way\u001b[0m\r\n"]
[18.089352, "o", "\u001b[35m\u001b[1magent\u001b[0m \u001b[2m→ Write\u001b[0m src/comments.ts\r\n"]
[18.090565, "o", "\u001b[2m    export function show(node: HTMLElement, comment: string) {\u001b[0m\r\n\u001b[2m      node.textContent = comment;\u001b[0m\r\n\u001b[2m    }\u001b[0m\r\n"]
[20.275708, "o", "\u001b[32m\u001b[1m✓ allowed\u001b[0m\r\n"]
[21.878903, "o", "\r\n\u001b[2m# It adds a sprawling function: allowed, but flagged as a new hotspot\u001b[0m\r\n"]
[22.680251, "o", "\u001b[35m\u001b[1magent\u001b[0m \u001b[2m→ Write\u001b[0m src/discounts.ts\r\n"]
[22.681601, "o", "\u001b[2m    export function discount(tier: string, cents: number, coupon?: string): number {\u001b[0m\r\n\u001b[2m      if (tier === \"t0\" && coupon) return cents * 90 / 100;\u001b[0m\r\n\u001b[2m      if (tier === \"t1\") return cents * 89 / 100;\u001b[0m\r\n\u001b[2m      if (tier === \"t2\") return cents * 88 / 100;\u001b[0m\r\n\u001b[2m      if (tier === \"t3\" && coupon) return cents * 87 / 100;\u001b[0m\r\n\u001b[2m      if (tier === \"t4\") return cents * 86 / 100;\u001b[0m\r\n"]
[24.854616, "o", "\u001b[32m\u001b[1m✓ allowed\u001b[0m\r\n"]
[24.856543, "o", "  \u001b[33mloki/slop-complexity: discount cyclomatic complexity 17 (> 10); split it into smaller \u001b[0m\r\n  \u001b[33mfunctions\u001b[0m\r\n"]
